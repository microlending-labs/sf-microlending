<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Interest_Rate_Within_Bounds</fullName>
    <active>true</active>
    <errorConditionFormula>OR(Annual_Interest_Rate__c &lt; 0, Annual_Interest_Rate__c &gt; 1)</errorConditionFormula>
    <errorDisplayField>Annual_Interest_Rate__c</errorDisplayField>
    <errorMessage>Annual Interest Rate must be between 0% and 100%.</errorMessage>
</ValidationRule>
