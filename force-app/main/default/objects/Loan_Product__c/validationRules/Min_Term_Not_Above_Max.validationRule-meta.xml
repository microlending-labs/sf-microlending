    <active>true</active>
    <errorConditionFormula>Min_Term_Months__c &gt; Max_Term_Months__c</errorConditionFormula>
    <errorMessage>Min Term (Months) cannot exceed Max Term (Months).</errorMessage>
</ValidationRule>
