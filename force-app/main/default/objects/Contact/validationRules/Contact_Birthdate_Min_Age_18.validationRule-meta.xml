<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Contact_Birthdate_Min_Age_18</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Birthdate)), Birthdate &gt; ADDMONTHS(TODAY(), -216))</errorConditionFormula>
    <errorDisplayField>Birthdate</errorDisplayField>
    <errorMessage>Birthdate must be at least 18 years before today.</errorMessage>
</ValidationRule>
