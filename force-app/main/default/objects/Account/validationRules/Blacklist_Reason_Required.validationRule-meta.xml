<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Blacklist_Reason_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(Blacklisted__c, ISBLANK(Blacklist_Reason__c))</errorConditionFormula>
    <errorDisplayField>Blacklist_Reason__c</errorDisplayField>
    <errorMessage>Blacklist Reason is required when Blacklisted is checked.</errorMessage>
</ValidationRule>
